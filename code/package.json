{
  "name": "frigateview",
  "productName": "FrigateView",
  "version": "0.1.0",
  "description": "Mur vidéo de bureau pour Frigate NVR",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "mock": "node dev/mock-frigate.mjs",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "fr.idsynergy.frigateview",
    "productName": "FrigateView",
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.44"
  }
}

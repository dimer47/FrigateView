{
  "name": "frigateview",
  "productName": "FrigateView",
  "version": "0.1.0",
  "description": "Mur vidéo de bureau pour Frigate NVR",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "mock": "node dev/mock-frigate.mjs",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "release": "electron-vite build && electron-builder --publish always"
  },
  "build": {
    "appId": "fr.idsynergy.frigateview",
    "productName": "FrigateView",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "legalTrademarks": "IDSynergy"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FrigateView",
      "artifactName": "FrigateView-Setup-${version}.${ext}",
      "uninstallDisplayName": "FrigateView"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "copyright": "© 2026 IDSynergy",
    "publish": [
      {
        "provider": "github",
        "owner": "dimer47",
        "repo": "FrigateView",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "artifactName": "FrigateView-${version}-${arch}.${ext}",
      "title": "FrigateView ${version}"
    },
    "afterPack": "build/adhoc-sign.cjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "hls.js": "^1.7.3",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "author": {
    "name": "IDSynergy",
    "email": "iachi.dimitri@gmail.com"
  },
  "homepage": "https://github.com/dimer47/FrigateView",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimer47/FrigateView.git"
  }
}
